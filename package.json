{
  "name": "spurlos",
  "version": "0.1.0",
  "description": "Ruft eine Website wie ein neuer Besucher auf und zeigt, was vor jedem Klick an fremde Server geht und welche Cookies gesetzt werden.",
  "keywords": [
    "privacy",
    "gdpr",
    "dsgvo",
    "cookies",
    "website-checker",
    "security-headers",
    "third-party",
    "playwright",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Martin Mohr",
  "homepage": "https://github.com/mmohrx/spurlos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmohrx/spurlos.git"
  },
  "bugs": {
    "url": "https://github.com/mmohrx/spurlos/issues"
  },
  "bin": {
    "spurlos": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --experimental-strip-types src/cli.ts",
    "examples": "node --experimental-strip-types scripts/examples.ts",
    "logo": "node scripts/logo.mjs"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.4.2"
}
